<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.sd.saleInv.SaleInvItemMapper">

    <resultMap type="com.szd.z000.base.orm.domain.sd.saleInv.SaleInvItem" id="Result">
        <id property="invId" column="inv_id"/>
        <id property="itemNo" column="item_no"/>
        <result property="vbelnVl" column="vbeln_vl"/>
    </resultMap>

    <sql id="selectSql">
        select * from z000_sd_sale_inv_item
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where inv_id = #{invId}
        order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_sd_sale_inv_item (inv_id, item_no, vbeln_vl)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.invId}, #{item.itemNo}, #{item.vbelnVl})
        </foreach>
    </insert>

    <delete id="deleteByInvId" parameterType="String">
        delete from z000_sd_sale_inv_item where inv_id = #{invId}
    </delete>

    <select id="selectInvoicedVbelnVl" resultType="string">
        SELECT i.vbeln_vl
        FROM z000_sd_sale_inv_item i
        INNER JOIN z000_sd_sale_inv_header h ON i.inv_id = h.inv_id
        WHERE i.vbeln_vl IN
        <foreach collection="vbelnVlList" item="vbelnVl" open="(" separator="," close=")">
            #{vbelnVl}
        </foreach>
        AND h.buss_status != 'E'
        AND (h.rev_bill_doc IS NULL OR h.rev_bill_doc = '')
        <if test="excludeInvId != null and excludeInvId != ''">
            AND i.inv_id != #{excludeInvId}
        </if>
    </select>
</mapper>
