<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.sd.saleOrder.SaleOrderItemMapper">

    <resultMap type="com.szd.z000.base.orm.domain.sd.saleOrder.SaleOrderItem" id="Result">
        <id property="orderId" column="order_id"/>
        <id property="itemNo" column="item_no"/>
        <result property="mtlCode" column="mtl_code"/>
        <result property="mtlName" column="mtl_name"/>
        <result property="entryQnt" column="entry_qnt"/>
        <result property="unit" column="unit"/>
        <result property="unitName" column="unit_name"/>
        <result property="itemText" column="item_text"/>
        <result property="deliveryDate" column="delivery_date"/>
    </resultMap>

    <sql id="selectSql">
        select * from z000_sd_sale_order_item
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where order_id = #{orderId}
        order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_sd_sale_order_item (order_id, item_no, mtl_code, mtl_name, entry_qnt, unit, unit_name, delivery_date, item_text)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.itemNo}, #{item.mtlCode}, #{item.mtlName}, #{item.entryQnt}, #{item.unit}, #{item.unitName}, #{item.deliveryDate}, #{item.itemText})
        </foreach>
    </insert>

    <delete id="deleteByOrderId" parameterType="String">
        delete from z000_sd_sale_order_item where order_id = #{orderId}
    </delete>

    <delete id="deleteByOrderIdAndItemNo">
        delete from z000_sd_sale_order_item where order_id = #{orderId} and item_no = #{itemNo}
    </delete>
</mapper>
