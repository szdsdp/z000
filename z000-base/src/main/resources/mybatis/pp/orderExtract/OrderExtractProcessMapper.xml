<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.pp.orderExtract.OrderExtractProcessMapper">

    <resultMap type="com.szd.z000.base.orm.domain.pp.orderExtract.OrderExtractProcess" id="Result">
        <id property="orderNo" column="order_no"/>
        <id property="itemNo" column="item_no"/>
        <result property="routingNo" column="routing_no"/>
        <result property="operInnerNo" column="oper_inner_no"/>
        <result property="operNo" column="oper_no"/>
        <result property="stdTextCode" column="std_text_code"/>
        <result property="operDesc" column="oper_desc"/>
    </resultMap>

    <sql id="selectSql">select * from z000_pp_order_extract_process</sql>

    <select id="selectByOrderNo" resultMap="Result">
        <include refid="selectSql"/> where order_no = #{orderNo} order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_pp_order_extract_process (order_no, item_no, routing_no, oper_inner_no, oper_no, std_text_code,
        oper_desc)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderNo}, #{item.itemNo}, #{item.routingNo}, #{item.operInnerNo}, #{item.operNo}, #{item.stdTextCode}, #{item.operDesc})
        </foreach>
    </insert>

    <delete id="deleteByOrderNo">
        delete from z000_pp_order_extract_process where order_no = #{orderNo}
    </delete>
</mapper>
