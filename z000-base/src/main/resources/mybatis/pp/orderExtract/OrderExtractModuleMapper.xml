<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.pp.orderExtract.OrderExtractModuleMapper">

    <resultMap type="com.szd.z000.base.orm.domain.pp.orderExtract.OrderExtractModule" id="Result">
        <id property="orderNo" column="order_no"/>
        <id property="itemNo" column="item_no"/>
        <result property="resNo" column="res_no"/>
        <result property="resItem" column="res_item"/>
        <result property="mtlCode" column="mtl_code"/>
        <result property="fact" column="fact"/>
        <result property="store" column="store"/>
        <result property="reqDate" column="req_date"/>
        <result property="reqQty" column="req_qty"/>
        <result property="unit" column="unit"/>
    </resultMap>

    <sql id="selectSql">select *
                        from z000_pp_order_extract_module</sql>

    <select id="selectByOrderNo" resultMap="Result">
        <include refid="selectSql"/>
        where order_no = #{orderNo} order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_pp_order_extract_module (order_no, item_no, res_no, res_item, mtl_code, fact, store, req_date,
        req_qty, unit)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderNo}, #{item.itemNo}, #{item.resNo}, #{item.resItem}, #{item.mtlCode}, #{item.fact}, #{item.store},
                #{item.reqDate}, #{item.reqQty}, #{item.unit})
        </foreach>
    </insert>

    <delete id="deleteByOrderNo">
        delete
        from z000_pp_order_extract_module
        where order_no = #{orderNo}
    </delete>
</mapper>
