<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mm.check.checkTask.CheckTaskHeaderMapper">

    <resultMap type="com.szd.z000.base.orm.domain.mm.check.checkTask.CheckTaskHeader" id="Result">
        <result property="taskId" column="task_id"/>
        <result property="planId" column="plan_id"/>
        <result property="bussDocId" column="buss_doc_id"/>
        <result property="fact" column="fact"/>
        <result property="store" column="store"/>
        <result property="taskStatus" column="task_status"/>
        <result property="blindFlag" column="blind_flag"/>
        <result property="bussStatus" column="buss_status"/>
        <result property="bstp" column="bstp"/>
        <result property="routerCode" column="router_code"/>
        <result property="title" column="title"/>
        <result property="bussDate" column="buss_date"/>
        <result property="remark" column="remark"/>
        <result property="cmpy" column="cmpy"/>
        <result property="cstc" column="cstc"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSql">
        select * from z000_mm_check_task_header2
    </sql>

    <select id="selectList" parameterType="com.szd.core.client.domain.common.ClientRpParam" resultMap="Result">
        <include refid="selectSql"/>
        <where>
            AND @S@ buss_doc_id = bussDocId @E@
            AND @S@ plan_id = planId @E@
            AND @S@ fact = fact @E@
            AND @S@ store = store @E@
            AND @S@ task_status = taskStatus @E@
            AND @S@ buss_status = bussStatus @E@
            AND @S@ create_time = createTime @E@
        </where>
        <if test="orders != null and orders.size() > 0">
            @OS orders @OE</if>
        <if test="orders == null or orders.size() == 0">
            ORDER BY create_time DESC
        </if>
    </select>

    <select id="selectById" parameterType="string" resultMap="Result">
        <include refid="selectSql" />
        where task_id = #{taskId}
    </select>

    <insert id="insert">
        INSERT INTO z000_mm_check_task_header2 (task_id, plan_id, buss_doc_id, fact, store,
                                               task_status, blind_flag, buss_status, bstp, router_code,
                                               buss_date, title, remark, cmpy, cstc,
                                               create_by, create_time)
        VALUES (#{taskId}, #{planId}, #{bussDocId}, #{fact}, #{store},
                #{taskStatus}, #{blindFlag}, #{bussStatus}, #{bstp}, #{routerCode},
                #{bussDate}, #{title}, #{remark}, #{cmpy}, #{cstc},
                #{createBy}, #{createTime})
    </insert>

    <update id="update">
        UPDATE z000_mm_check_task_header2
        SET
            fact           = #{fact},
            store          = #{store},
            task_status    = #{taskStatus},
            buss_date      = #{bussDate},
            buss_doc_id    = #{bussDocId},
            bstp           = #{bstp},
            router_code    = #{routerCode},
            title          = #{title},
            remark         = #{remark},
            cmpy           = #{cmpy},
            cstc           = #{cstc},
            update_by      = #{updateBy},
            update_time    = #{updateTime}
        where task_id = #{taskId}
    </update>

    <update id="updateStatusAndDocId">
        UPDATE z000_mm_check_task_header2
        SET buss_status = #{bussStatus},
            buss_doc_id = #{bussDocId}
        WHERE task_id = #{taskId}
    </update>

    <update id="updateTaskStatus">
        UPDATE z000_mm_check_task_header2
        SET task_status = #{taskStatus}
        WHERE task_id = #{taskId}
    </update>

    <delete id="deleteById">
        DELETE FROM z000_mm_check_task_header2 WHERE task_id = #{taskId}
    </delete>

    <select id="selectByPlanId" parameterType="string" resultMap="Result">
        <include refid="selectSql" />
        where plan_id = #{planId}
        order by create_time
    </select>
</mapper>
