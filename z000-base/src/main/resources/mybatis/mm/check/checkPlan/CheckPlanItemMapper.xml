<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mm.check.checkPlan.CheckPlanItemMapper">

    <resultMap type="com.szd.z000.base.orm.domain.mm.check.checkPlan.CheckPlanItem" id="Result">
        <id property="planId" column="plan_id"/>
        <id property="itemNo" column="item_no"/>
        <result property="fact" column="fact"/>
        <result property="factName" column="fact_name"/>
        <result property="store" column="store"/>
        <result property="storeName" column="store_name"/>
    </resultMap>

    <sql id="selectSql">
        select *
        from z000_mm_check_plan_item
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where plan_id = #{planId}
        order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_mm_check_plan_item (plan_id, item_no, fact, store)
        values
        <foreach collection="list" item="item" separator=",">
                (#{item.planId}, #{item.itemNo}, #{item.fact}, #{item.store})
        </foreach>
    </insert>

    <delete id="deleteByPlanId" parameterType="String">
        delete
        from z000_mm_check_plan_item
        where plan_id = #{planId}
    </delete>

    <delete id="deleteByPlanIdAndItemNo">
        delete
        from z000_mm_check_plan_item
        where plan_id = #{planId}
          and item_no = #{itemNo}
    </delete>
</mapper>
