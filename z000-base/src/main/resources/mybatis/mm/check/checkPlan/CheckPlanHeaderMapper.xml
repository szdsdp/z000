<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mm.check.checkPlan.CheckPlanHeaderMapper">

    <resultMap type="com.szd.z000.base.orm.domain.mm.check.checkPlan.CheckPlanHeader" id="Result">
        <result property="planId" column="plan_id"/>
        <result property="postDate" column="post_date"/>
        <result property="vchDate" column="vch_date"/>
        <result property="mblnr" column="mblnr"/>
        <result property="mjahr" column="mjahr"/>
        <result property="sapMessId" column="sap_mess_id"/>
        <result property="sapMsg" column="sap_msg"/>
        <result property="month" column="month"/>
        <result property="blindFlag" column="blind_flag"/>
        <result property="planStatus" column="plan_status"/>
        <result property="revMblnr" column="rev_mblnr"/>
        <result property="revMjahr" column="rev_mjahr"/>
        <result property="revSapMsg" column="rev_sap_msg"/>
        <result property="revSapMessId" column="rev_sap_mess_id"/>
        <result property="bussDocId" column="buss_doc_id"/>
        <result property="bussDate" column="buss_date"/>
        <result property="bussStatus" column="buss_status"/>
        <result property="bstp" column="bstp"/>
        <result property="routerCode" column="router_code"/>
        <result property="title" column="title"/>
        <result property="remark" column="remark"/>
        <result property="cmpy" column="cmpy"/>
        <result property="cstc" column="cstc"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSql">
        select * from z000_mm_check_plan_header
    </sql>

    <select id="selectList" parameterType="com.szd.core.client.domain.common.ClientRpParam" resultMap="Result">
        <include refid="selectSql"/>
        <where>
            AND @S@ buss_doc_id = bussDocId @E@
            AND @S@ buss_date = bussDate @E@
            AND @S@ buss_status = bussStatus @E@
            AND @S@ cmpy = cmpy @E@
            AND @S@ cstc = cstc @E@
            AND @S@ create_time = createTime @E@
        </where>
        <if test="orders != null and orders.size() > 0">
            @OS orders @OE</if>
        <if test="orders == null or orders.size() == 0">
            ORDER BY create_time DESC
        </if>
    </select>

    <select id="selectById" parameterType="string" resultMap="Result">
        <include refid="selectSql" />
        where plan_id = #{planId}
    </select>

    <insert id="insert">
        INSERT INTO z000_mm_check_plan_header (plan_id, buss_doc_id, post_date, vch_date,
                                         buss_date, buss_status, bstp, router_code, title, remark, cmpy, cstc,
                                         create_by, create_time, month, blind_flag, plan_status)
        VALUES (#{planId}, #{bussDocId}, #{postDate}, #{vchDate},
                #{bussDate}, #{bussStatus}, #{bstp}, #{routerCode}, #{title}, #{remark}, #{cmpy}, #{cstc},
                #{createBy}, #{createTime}, #{month}, #{blindFlag}, #{planStatus})
    </insert>

    <update id="update">
        UPDATE z000_mm_check_plan_header
        SET
            post_date      = #{postDate},
            vch_date       = #{vchDate},
            buss_doc_id    = #{bussDocId},
            buss_date      = #{bussDate},
            bstp           = #{bstp},
            router_code    = #{routerCode},
            title          = #{title},
            remark         = #{remark},
            cmpy           = #{cmpy},
            cstc           = #{cstc},
            update_by      = #{updateBy},
            update_time    = #{updateTime},
            month          = #{month},
            blind_flag     = #{blindFlag},
            plan_status    = #{planStatus}
        where plan_id = #{planId}
    </update>

    <update id="updateStatusAndDocId">
        UPDATE z000_mm_check_plan_header
        SET buss_status = #{bussStatus},
            buss_doc_id = #{bussDocId}
        WHERE plan_id = #{planId}
    </update>

    <update id="updateSapRet">
        update z000_mm_check_plan_header
        <set>
            <if test="mblnr != null and mblnr != ''">
                buss_status = 'F',
                mblnr = #{mblnr},
            </if>
            <if test="mjahr != null and mjahr != ''">
                mjahr = #{mjahr},
            </if>
            <if test="sapMsg != null and sapMsg != ''">
                sap_msg = #{sapMsg},
            </if>
            <if test="sapMessId != null and sapMessId != ''">
                sap_mess_id = #{sapMessId},
            </if>
        </set>
        where plan_id = #{planId}
    </update>

    <update id="updateReverseSapRet">
        update z000_mm_check_plan_header
        <set>
            <if test="revMblnr != null and revMblnr != ''">
                rev_mblnr = #{revMblnr},
            </if>
            <if test="revMjahr != null and revMjahr != ''">
                rev_mjahr = #{revMjahr},
            </if>
            <if test="revSapMsg != null and revSapMsg != ''">
                rev_sap_msg = #{revSapMsg},
            </if>
            <if test="revSapMessId != null and revSapMessId != ''">
                rev_sap_mess_id = #{revSapMessId},
            </if>
        </set>
        where plan_id = #{planId}
    </update>

    <delete id="deleteById">
        DELETE FROM z000_mm_check_plan_header WHERE plan_id = #{planId}
    </delete>

    <update id="updatePlanStatus">
        UPDATE z000_mm_check_plan_header SET plan_status = #{planStatus} WHERE plan_id = #{planId}
    </update>

    <update id="updateBussStatus">
        UPDATE z000_mm_check_plan_header SET buss_status = #{bussStatus} WHERE plan_id = #{planId}
    </update>
</mapper>
