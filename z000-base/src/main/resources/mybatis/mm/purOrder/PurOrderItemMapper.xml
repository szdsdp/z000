<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mm.purOrder.PurOrderItemMapper">

    <resultMap type="com.szd.z000.base.orm.domain.mm.purOrder.PurOrderItem" id="Result">
        <id property="orderId" column="order_id"/>
        <id property="itemNo" column="item_no"/>
        <result property="mtlCode" column="mtl_code"/>
        <result property="fact" column="fact"/>
        <result property="purNum" column="pur_num"/>
        <result property="unit" column="unit"/>
        <result property="applyNo" column="apply_no"/>
        <result property="applyNoItem" column="apply_no_item"/>
        <result property="deliveryDate" column="delivery_date"/>
    </resultMap>

    <sql id="selectSql">
        select *
        from z000_mm_pur_order_item
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where order_id = #{orderId}
        order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_mm_pur_order_item (order_id, item_no, mtl_code, fact, pur_num, unit, apply_no, apply_no_item, delivery_date)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.itemNo}, #{item.mtlCode}, #{item.fact}, #{item.purNum}, #{item.unit}, #{item.applyNo}, #{item.applyNoItem}, #{item.deliveryDate})
        </foreach>
    </insert>

    <select id="selectByPreqNo" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where apply_no = #{applyNo}
    </select>

    <delete id="deleteByPurOrderId" parameterType="String">
        delete
        from z000_mm_pur_order_item
        where order_id = #{orderId}
    </delete>

    <delete id="deleteByPurOrderIdAndItemNo">
        delete
        from z000_mm_pur_order_item
        where order_id = #{orderId}
          and item_no = #{itemNo}
    </delete>
</mapper>
