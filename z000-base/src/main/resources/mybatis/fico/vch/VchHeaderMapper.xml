<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.fico.vch.VchHeaderMapper">

    <resultMap type="com.szd.z000.base.orm.domain.fico.vch.VchHeader" id="Result">
        <result property="costId" column="cost_id"/>
        <result property="bussDocId" column="buss_doc_id"/>
        <result property="cmpy" column="cmpy"/>
        <result property="bussDate" column="buss_date"/>
        <result property="bussStatus" column="buss_status"/>
        <result property="bstp" column="bstp"/>
        <result property="routerCode" column="router_code"/>
        <result property="title" column="title"/>
        <result property="remark" column="remark"/>
        <result property="cstc" column="cstc"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="amtApply" column="amt_apply"/>
        <result property="sapMsg" column="sap_msg"/>
        <result property="sapMessId" column="sap_mess_id"/>
        <result property="belnr" column="belnr"/>
        <result property="gjahr" column="gjahr"/>
        <result property="curr" column="curr"/>
    </resultMap>

    <sql id="selectSql">
        select * from z000_fi_vch_header
    </sql>

    <select id="selectList" parameterType="com.szd.core.client.domain.common.ClientRpParam" resultMap="Result">
        <include refid="selectSql"/>
        <where>
            AND @S@ buss_doc_id = bussDocId @E@
            AND @S@ buss_date = bussDate @E@
            AND @S@ buss_status = bussStatus @E@
            AND @S@ cmpy = cmpy @E@
            AND @S@ cstc = cstc @E@
            AND @S@ bstp = bstp @E@
            AND @S@ create_time = createTime @E@
        </where>
        <if test="orders != null and orders.size() > 0">
            @OS orders @OE</if>
        <if test="orders == null or orders.size() == 0">
            ORDER BY create_time DESC
        </if>
    </select>

    <select id="selectById" parameterType="string" resultMap="Result">
        <include refid="selectSql" />
        where cost_id = #{costId}
    </select>

    <insert id="insert">
        INSERT INTO z000_fi_vch_header (cost_id, buss_doc_id, cmpy, buss_date, buss_status, bstp, router_code, title, remark, cstc,
                                        create_by, create_time, amt_apply, curr)
        VALUES (#{costId}, #{bussDocId}, #{cmpy}, #{bussDate}, #{bussStatus}, #{bstp}, #{routerCode}, #{title}, #{remark}, #{cstc},
                #{createBy}, #{createTime}, #{amtApply}, #{curr})
    </insert>

    <update id="update">
        UPDATE z000_fi_vch_header
        SET buss_doc_id = #{bussDocId},
            cmpy        = #{cmpy},
            buss_date   = #{bussDate},
            bstp        = #{bstp},
            router_code = #{routerCode},
            title       = #{title},
            remark      = #{remark},
            cstc        = #{cstc},
            update_by   = #{updateBy},
            update_time = #{updateTime},
            amt_apply   = #{amtApply},
            curr        = #{curr}
        where cost_id = #{costId}
    </update>

    <update id="updateStatusAndDocId">
        UPDATE z000_fi_vch_header
        SET buss_status = #{bussStatus},
            buss_doc_id = #{bussDocId}
        WHERE cost_id = #{costId}
    </update>

    <update id="updateSapInfo">
        update z000_fi_vch_header
        <set>
            <if test="belnr != null and belnr != ''">
                belnr = #{belnr},
                buss_status = 'F',
            </if>
            <if test="gjahr != null and gjahr != ''">
                gjahr = #{gjahr},
            </if>
            <if test="sapMsg != null and sapMsg != ''">
                sap_msg = #{sapMsg},
            </if>
            <if test="sapMessId != null and sapMessId != ''">
                sap_mess_id = #{sapMessId},
            </if>
        </set>
        where cost_id = #{costId}
    </update>

    <delete id="deleteById">
        DELETE FROM z000_fi_vch_header WHERE cost_id = #{costId}
    </delete>
</mapper>
