<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mdm.cust.MdmCustCmpyMapper">
    <resultMap type="com.szd.z000.base.orm.domain.mdm.cust.MdmCustCmpy" id="Result">
        <id property="applyId" column="apply_id"/>
        <result property="itemNo" column="item_no"/>
        <result property="custFlag" column="cust_flag"/>
        <result property="cmpy" column="cmpy"/>
        <result property="accs" column="accs"/>
        <result property="payTerms" column="pay_terms"/>
        <result property="payType" column="pay_type"/>
    </resultMap>

    <sql id="selectSql">
        select *
        from z000_mdm_cust_cmpy
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where apply_id = #{applyId}
        order by item_no
    </select>

    <insert id="batchInsert">
        insert into z000_mdm_cust_cmpy (apply_id, item_no, cust_flag, cmpy, accs, pay_terms, pay_type)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.applyId}, #{item.itemNo}, #{item.custFlag}, #{item.cmpy}, #{item.accs}, #{item.payTerms}, #{item.payType})
        </foreach>
    </insert>

    <delete id="deleteByApplyId" parameterType="String">
        delete
        from z000_mdm_cust_cmpy
        where apply_id = #{applyId}
    </delete>

    <delete id="deleteByApplyIdAndFlag">
        delete
        from z000_mdm_cust_cmpy
        where apply_id = #{applyId} and cust_flag = #{custFlag}
    </delete>
</mapper>
