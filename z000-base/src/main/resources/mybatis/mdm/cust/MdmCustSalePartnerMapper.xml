<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.szd.z000.base.orm.mapper.mdm.cust.MdmCustSalePartnerMapper">
    <resultMap type="com.szd.z000.base.orm.domain.mdm.cust.MdmCustSalePartner" id="Result">
        <id property="applyId" column="apply_id"/>
        <result property="itemNo" column="item_no"/>
        <result property="saleOrg" column="sale_org"/>
        <result property="partnerType" column="partner_type"/>
        <result property="partnerCode" column="partner_code"/>
    </resultMap>

    <sql id="selectSql">
        select *
        from z000_mdm_cust_sale_partner
    </sql>

    <select id="selectList" parameterType="String" resultMap="Result">
        <include refid="selectSql"/>
        where apply_id = #{applyId} and sale_org = #{saleOrg}
        order by partner_type, partner_code
    </select>

    <insert id="batchInsert">
        insert into z000_mdm_cust_sale_partner (apply_id, item_no, sale_org, partner_type, partner_code)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.applyId}, #{item.itemNo}, #{item.saleOrg}, #{item.partnerType}, #{item.partnerCode}
            )
        </foreach>
    </insert>

    <delete id="deleteById" parameterType="String">
        delete
        from z000_mdm_cust_sale_partner
        where apply_id = #{applyId} and sale_org = #{saleOrg}
    </delete>
</mapper>
